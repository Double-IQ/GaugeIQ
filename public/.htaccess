Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    # Revalidate application documents and code before reusing cached copies.
    <FilesMatch "\.(?:html?|php|js|mjs|css|json)$">
        Header always set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "DENY"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(self)"
    Header always unset Content-Security-Policy
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://unpkg.com; style-src 'self' 'unsafe-inline' https://unpkg.com; img-src 'self' data: blob: https://cdn.meteocons.com https://tile.openstreetmap.org https://*.basemaps.cartocdn.com https://tiles.openfreemap.org; connect-src 'self' https://api.open-meteo.com https://archive-api.open-meteo.com https://historical-forecast-api.open-meteo.com https://unpkg.com https://openmeteo.s3.amazonaws.com https://static-assets.open-meteo.com https://tile.openstreetmap.org https://*.basemaps.cartocdn.com https://tiles.openfreemap.org; worker-src 'self' blob: https://unpkg.com; manifest-src 'self'; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com https://maps.open-meteo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]
</IfModule>
